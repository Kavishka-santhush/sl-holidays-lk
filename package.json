{
  "name": "sl-holidays-lk",
  "version": "1.0.0",
  "description": "A lightweight TypeScript/JavaScript library to check and retrieve Sri Lankan Public, Bank, and Mercantile holidays.",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "prepublishOnly": "npm run test && npm run build"
  },
  "keywords": [
    "sri-lanka",
    "holidays",
    "calendar",
    "poya",
    "public-holidays",
    "lk"
  ],
  "author": "Kavishka Santhush",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/YOUR_USERNAME/sl-holidays-lk.git"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.5.1",
    "typescript": "5.7.3",
    "vitest": "^2.0.0"
  }
}